[Unit]
Description=Journal Ippolitovka - Student Attendance System
Documentation=https://github.com/imaxalexey-a11y/journal-ippolitovka
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/journal-ippolitovka
Environment=NODE_ENV=production
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=journal-ippolitovka

[Install]
WantedBy=multi-user.target
